# ###########################################################################
# .streamlit/secrets.toml — EXEMPLO (copiar e preencher)
#
# ATENÇÃO: este ficheiro contém credenciais. Adicione-o ao .gitignore.
# Em Streamlit Community Cloud: Settings → Secrets → colar este conteúdo.
# ###########################################################################

# ID da folha de cálculo (parte do URL:
# https://docs.google.com/spreadsheets/d/<ESTE-VALOR>/edit)
GOOGLE_SHEETS_SPREADSHEET_ID = "1AbCdEfGhIjKlMnOpQrStUvWxYz0123456789"

# Alternativa (menos robusta) ao ID:
# GOOGLE_SHEETS_SPREADSHEET_NAME = "Registo de Manifestações"

# Aba que guarda as opções dos dropdowns
GOOGLE_SHEETS_CATALOGS_TAB = "Catalogs"

# TTL da cache de leitura, em segundos (use "none" para desativar a expiração)
SHEETS_CACHE_TTL_SECONDS = "300"

# --------------------------------------------------------------------------
# Service Account (conteúdo integral do JSON descarregado da Google Cloud)
# A chave "private_key" mantém os \n escapados, tal como no JSON original.
# --------------------------------------------------------------------------
[gcp_service_account]
type = "service_account"
project_id = "meu-projeto"
private_key_id = "0123456789abcdef0123456789abcdef01234567"
private_key = "-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkq...\n-----END PRIVATE KEY-----\n"
client_email = "conector-sheets@meu-projeto.iam.gserviceaccount.com"
client_id = "123456789012345678901"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/conector-sheets%40meu-projeto.iam.gserviceaccount.com"
universe_domain = "googleapis.com"
